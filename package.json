{
  "name": "visual-opsec-preflight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "dev:demo": "NEXT_TELEMETRY_DISABLED=1 OPSEC_PROVIDER=demo next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests e2e next.config.ts playwright.config.ts vitest.config.mts tsconfig.json"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "next": "16.4.6",
    "openai": "7.56.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/piexifjs": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "piexifjs": "^1.0.6",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
